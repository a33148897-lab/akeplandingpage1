PORT=8787
NODE_ENV=development

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# ── Resend ─────────────────────────────────────────────────────────────────────
# Create a key at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Optional: add waitlist signups to a Resend Audience
# Resend → Audiences → copy the Audience ID
RESEND_AUDIENCE_ID=

# Must be on a domain verified in Resend
# https://resend.com/domains (verify akepapp.com)
FROM_EMAIL=no-reply@akepapp.com

# Where admin/internal submission notifications are delivered
NOTIFY_TO=info@akepapp.com

# ── Email content links ───────────────────────────────────────────────────────
AKEP_LINKEDIN_URL=https://linkedin.com/company/akepapp
AKEP_TWITTER_URL=https://twitter.com/akepapp
SUPPORT_URL=https://akepapp.com/support
